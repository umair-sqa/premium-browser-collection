{
  "manifest_version": 3,
  "name": "Deep Work — Aurevia Studio",
  "short_name": "Deep Work",
  "version": "1.0.0",
  "description": "A calm productivity New Tab with focus timer, todos, daily goals, and shortcuts — by Aurevia Studio.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Deep Work — Aurevia Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
