{
  "manifest_version": 3,
  "name": "Salah & Sun Companion — Aurevia Studio",
  "short_name": "Salah & Sun",
  "version": "1.0.0",
  "description": "Islamic prayer times, Hijri date, Qibla bearing, and sun times for your New Tab — by Aurevia Studio.",
  "permissions": ["storage", "alarms", "notifications"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Salah & Sun Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
