{
  "manifest_version": 3,
  "name": "Cosmos — Aurevia Studio",
  "short_name": "Cosmos",
  "version": "1.0.0",
  "description": "Astronomy-inspired New Tab with world clocks, calendar, moon phase, and celestial education — by Aurevia Studio.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.open-meteo.com/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cosmos — Aurevia Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
