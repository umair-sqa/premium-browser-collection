{
  "manifest_version": 3,
  "name": "Noor — Aurevia Studio",
  "version": "1.0.0",
  "description": "A refined Chrome theme with Islamic geometric patterns in warm ivory, deep emerald, midnight blue, and gold.",
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_ntp_background": "images/theme_ntp_background.png"
    },
    "colors": {
      "frame": [18, 32, 28],
      "frame_inactive": [28, 42, 38],
      "frame_incognito": [12, 24, 36],
      "frame_incognito_inactive": [22, 34, 46],
      "toolbar": [32, 48, 42],
      "tab_text": [245, 238, 220],
      "tab_background_text": [170, 160, 140],
      "bookmark_text": [230, 220, 190],
      "ntp_background": [16, 28, 26],
      "ntp_text": [242, 235, 218],
      "ntp_link": [196, 160, 80],
      "ntp_header": [40, 56, 48],
      "ntp_section": [28, 42, 38],
      "button_background": [48, 72, 56]
    },
    "tints": {
      "buttons": [0.12, 0.35, 0.6],
      "frame": [0.4, 0.25, 0.14],
      "background_tab": [0.4, 0.15, 0.4]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat"
    }
  }
}
