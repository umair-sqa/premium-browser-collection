{
  "$schema": "https://aurevia.studio/schemas/design-tokens.json",
  "brand": "Aurevia Studio",
  "meta": {
    "version": "1.0.0",
    "description": "Shared design tokens for the Aurevia Studio premium browser collection. Product-specific palettes live alongside these shared scales."
  },
  "color": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F7F6F3",
      "100": "#EDEAE4",
      "200": "#D6D1C7",
      "300": "#B8B2A6",
      "400": "#8F897C",
      "500": "#6B665C",
      "600": "#4A4640",
      "700": "#2F2C29",
      "800": "#1C1A18",
      "900": "#0E0D0C",
      "950": "#070706"
    },
    "semantic": {
      "success": "#3D8F6A",
      "warning": "#C4922A",
      "danger": "#C45C4A",
      "info": "#4A7D9A"
    }
  },
  "typography": {
    "families": {
      "display": "Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Times New Roman', serif",
      "ui": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "2xl": "2rem",
      "3xl": "3rem",
      "4xl": "4.5rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.35,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "9": "6rem"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.24)",
    "md": "0 8px 24px rgba(0,0,0,0.32)",
    "lg": "0 24px 48px rgba(0,0,0,0.4)"
  },
  "surface": {
    "base": "rgba(10, 12, 16, 0.55)",
    "raised": "rgba(18, 22, 28, 0.72)",
    "overlay": "rgba(6, 8, 12, 0.82)",
    "border": "rgba(255, 255, 255, 0.08)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "240ms",
      "slow": "420ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "principles": [
      "Use motion to establish hierarchy and presence, not decoration.",
      "Prefer opacity and transform over layout-shifting animations.",
      "Respect prefers-reduced-motion."
    ]
  },
  "accessibility": {
    "minContrastBody": 4.5,
    "minContrastLarge": 3.0,
    "focusRing": "2px solid currentColor",
    "hitTargetMin": "44px"
  },
  "products": {
    "obsidian": { "accent": "#BEA06C", "bg": "#121214" },
    "shinobi": { "accent": "#A84048", "bg": "#0E0C0E" },
    "aurora": { "accent": "#50C8A0", "bg": "#081224" },
    "nebula": { "accent": "#A078FF", "bg": "#0A081C" },
    "dev-terminal": { "accent": "#50C878", "bg": "#0A0E0C" },
    "noor": { "accent": "#C4A050", "bg": "#101C1A" },
    "salah-sun": { "accent": "#C9A227", "bg": "#0B1A24" },
    "deep-work": { "accent": "#8FA88A", "bg": "#2C3530" },
    "devspace": { "accent": "#58A6FF", "bg": "#0D1117" },
    "cosmos": { "accent": "#7B6CF6", "bg": "#050814" }
  }
}
